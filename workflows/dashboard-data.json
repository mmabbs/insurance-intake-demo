    {
      "parameters": {
        "jsCode": "// Claude-built, demo use only. One item per run listed in audit_log, with how\n// many emails that run logged, so each run's details are fetched once.\nconst emailsByRun = {};\nfor (const item of $input.all()) {\n  const id = item.json.execution_id;\n  if (id === undefined || id === null) continue;\n  const key = String(Math.round(id));\n  emailsByRun[key] = (emailsByRun[key] ?? 0) + 1;\n}\nreturn Object.entries(emailsByRun).map(([executionId, emails]) => ({ json: { executionId, emails } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        608
      ],
      "id": "dc5bced1-d6cf-4b0e-9cab-b89797f82b64",
      "name": "List each run once (Code)"
    },
    {
      "parameters": {
        "resource": "execution",
        "operation": "get",
        "executionId": "={{ $json.executionId }}",
        "options": {
          "activeWorkflows": true
        }
      },
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        672,
        608
      ],
      "id": "5b2f371a-82f1-4b36-a7ac-05f6ad594641",
      "name": "Get each run's details (n8n)",
      "credentials": {
        "n8nApi": {
          "id": "lqonYEkGoASsnSij",
          "name": "n8n API (read runs only)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Claude-built, demo use only. Adds up the tokens of every Claude call in each\n// run listed in audit_log and prices them per model. Measured, not estimated:\n// the token counts are the ones n8n saved with each run.\n// USD per million tokens (in, out), from the Claude API reference cached\n// 2026-10-06, the same prices score_run.py uses.\nconst PRICES = {\n  'claude-haiku-5-5': [0.10, 0.50],\n  'claude-sonnet-5-5': [2.00, 10.00],\n  'claude-opus-5-5': [4.00, 20.00],\n};\nconst emailsByRun = {};\nfor (const item of $('List each run once (Code)').all()) {\n  emailsByRun[item.json.executionId] = item.json.emails;\n}\n\nconst runs = [];\nconst unpriced = new Set();\nlet unreadable = 0;\nfor (const item of $input.all()) {\n  const run = item.json.body ?? item.json;\n  const runData = run?.data?.resultData?.runData;\n  if (!runData) { unreadable++; continue; }\n  let tokensIn = 0, tokensOut = 0, cost = 0, calls = 0;\n  for (const node of run.workflowData?.nodes ?? []) {\n    if (!node.type.endsWith('.lmChatAnthropic')) continue;\n    const model = node.parameters?.model?.value ?? node.parameters?.model;\n    const price = PRICES[model];\n    for (const nodeRun of runData[node.name] ?? []) {\n      for (const out of nodeRun.data?.ai_languageModel?.[0] ?? []) {\n        const usage = out.json?.tokenUsage ?? {};\n        if (!price) { unpriced.add(String(model)); continue; }\n        tokensIn += usage.promptTokens ?? 0;\n        tokensOut += usage.completionTokens ?? 0;\n        cost += ((usage.promptTokens ?? 0) * price[0] + (usage.completionTokens ?? 0) * price[1]) / 1e6;\n        calls++;\n      }\n    }\n  }\n  runs.push({\n    execution_id: Number(run.id),\n    started_at: run.startedAt,\n    emails: emailsByRun[String(run.id)] ?? 0,\n    claude_calls: calls,\n    tokens_in: tokensIn,\n    tokens_out: tokensOut,\n    cost_usd: cost,\n  });\n}\nruns.sort((a, b) => a.execution_id - b.execution_id);\nconst sum = (key) => runs.reduce((total, r) => total + r[key], 0);\nconst emails = sum('emails');\nconst costUsd = sum('cost_usd');\nreturn [{ json: {\n  measured_at: new Date().toISOString(),\n  runs_counted: runs.length,\n  runs_unreadable: unreadable,\n  unpriced_models: [...unpriced],\n  emails,\n  claude_calls: sum('claude_calls'),\n  tokens_in: sum('tokens_in'),\n  tokens_out: sum('tokens_out'),\n  cost_usd: costUsd,\n  cost_per_email_usd: emails ? costUsd / emails : 0,\n  prices_source: 'Claude API reference, cached 2026-10-06',\n  runs,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        608
